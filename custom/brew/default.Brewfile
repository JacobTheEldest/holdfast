# Default Brewfile for holdfast
# Always-installed CLI tools for any holdfast machine.

# Modern CLI tools
brew "bat"          # cat with syntax highlighting
brew "eza"          # modern ls
brew "fd"           # simple, fast find
brew "rg"           # ripgrep is a faster grep

# Shell history & navigation
brew "atuin"        # synced shell history with search
brew "bash-preexec" # preexec/precmd hooks for bash (atuin companion)
brew "starship"     # cross-shell prompt
brew "zoxide"       # smarter cd
brew "direnv"       # per-directory env vars

# Git / VCS
brew "gh"           # GitHub CLI
brew "git"          # newer than bluefin's RPM
brew "jjui"         # TUI for jj (jujutsu)

# Utilities
brew "chezmoi"      # dotfile manager
brew "cosign"       # sign/verify container images
brew "htop"         # interactive process viewer
brew "tealdeer"     # fast tldr client
brew "tmux"         # terminal multiplexer
brew "trash-cli"    # rm that goes to trash, not oblivion
brew "yq"           # YAML/JSON/XML processor

# Bold Brew — TUI for Homebrew
tap "valkyrie00/bbrew"
brew "valkyrie00/bbrew/bbrew"
