# Graphics & Media
[Flatpak Preinstall com.github.PintaProject.Pinta]
Branch=stable

[Flatpak Preinstall com.github.rafostar.Clapper]
Branch=stable

# System Utilities
# Note: smile covers emoji input in the COSMIC session; GNOME has a built-in tool.
[Flatpak Preinstall it.mijorus.smile]
Branch=stable

[Flatpak Preinstall com.github.tchx84.Flatseal]
Branch=stable

[Flatpak Preinstall com.mattjakeman.ExtensionManager]
Branch=stable

[Flatpak Preinstall io.github.flattool.Warehouse]
Branch=stable

[Flatpak Preinstall io.github.flattool.Ignition]
Branch=stable

[Flatpak Preinstall io.missioncenter.MissionCenter]
Branch=stable

[Flatpak Preinstall io.gitlab.adhami3310.Impression]
Branch=stable

# Universal Blue Specific
# Note: io.github.kolunmi.Bazaar is preinstalled by bluefin-dx itself via
# /usr/share/flatpak/preinstall.d/bazaar.preinstall — no entry needed here.
[Flatpak Preinstall com.ranfdev.DistroShelf]
Branch=stable

[Flatpak Preinstall page.tesk.Refine]
Branch=stable

# Communication
[Flatpak Preinstall com.slack.Slack]
Branch=stable

[Flatpak Preinstall org.signal.Signal]
Branch=stable

[Flatpak Preinstall org.telegram.desktop]
Branch=stable

[Flatpak Preinstall dev.vencord.Vesktop]
Branch=stable

